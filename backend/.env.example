DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dmi_platform
DATABASE_USER=dmi_app
# Set this locally. Never commit the real password.
DATABASE_PASSWORD=
# Development may use prefer. Production Neon must use require (or a stricter
# owner-approved libpq mode); this value is never a credential.
DATABASE_SSLMODE=prefer
# Leave empty in normal operation. M12A's local E2E harness sets a temporary,
# validated schema name; production must not use this setting.
DATABASE_SCHEMA=

# Verification email delivery; fill secrets privately.
EMAIL_DELIVERY_PROVIDER=smtp
# Set EMAIL_DELIVERY_PROVIDER=brevo to use HTTPS; SMTP settings are then unused.
BREVO_API_KEY=
EMAIL_HTTP_TIMEOUT_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true: STARTTLS; false: implicit TLS on port 465 only (never plaintext).
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=AXIOM
FRONTEND_BASE_URL=http://127.0.0.1:3000
# Generate once with cryptography. Keep this stable across restarts until all
# queued reset emails expire; it is not a frontend or provider credential.
PASSWORD_RESET_OUTBOX_ENCRYPTION_KEY=
PASSWORD_RESET_OUTBOX_POLL_SECONDS=5
PASSWORD_RESET_OUTBOX_BATCH_SIZE=10
PASSWORD_RESET_OUTBOX_MAX_ATTEMPTS=5

# Optional private Google Drive storage for M20 course-material uploads.
# Keep disabled until a dedicated private Drive folder and exactly one token
# source are configured. Never commit a token or client credential.
MATERIALS_STORAGE_PROVIDER=disabled
MATERIALS_GOOGLE_DRIVE_FOLDER_ID=
MATERIALS_GOOGLE_DRIVE_TOKEN_FILE=
MATERIALS_GOOGLE_DRIVE_TOKEN_JSON=
MATERIALS_MAX_UPLOAD_BYTES=25000000
# Study Partner attachments reuse the same private Drive adapter, with a
# deliberately smaller cap. Files remain unavailable until storage is enabled.
STUDY_PARTNER_CHAT_MAX_ATTACHMENT_BYTES=5000000

# Optional manual LOCAL demo seeding. Never enable in production.
DEMO_SEED_ENABLED=false
DEMO_STUDENT_PASSWORD=
DEMO_DEMONSTRATOR_PASSWORD=
DEMO_LECTURER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# PDF generation is opt-in. Docker mode uses the locally loaded, pinned POC image.
PDF_COMPILER_MODE=disabled
PDF_DOCKER_EXECUTABLE=docker
PDF_TECTONIC_EXECUTABLE=/usr/local/bin/tectonic
PDF_CACHE_DIRECTORY=/opt/tectonic-cache
PDF_TIMEOUT_SECONDS=30
PDF_MAX_BYTES=4000000

# Local HTTP only. Set true when served over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
AUTH_REQUESTS_PER_MINUTE=30
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]
