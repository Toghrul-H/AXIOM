DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dmi_platform
DATABASE_USER=dmi_app
# Set this locally. Never commit the real password.
DATABASE_PASSWORD=

# Verification email delivery; fill secrets privately.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true: STARTTLS; false: implicit TLS on port 465 only (never plaintext).
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=AXIOM
FRONTEND_BASE_URL=http://127.0.0.1:3000

# Optional manual LOCAL demo seeding. Never enable in production.
DEMO_SEED_ENABLED=false
DEMO_STUDENT_PASSWORD=
DEMO_DEMONSTRATOR_PASSWORD=
DEMO_LECTURER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Local HTTP only. Set true when served over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
AUTH_REQUESTS_PER_MINUTE=30
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000"]
